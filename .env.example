# CampusConnect environment template — copy to .env.local and fill in.
# Placeholder values only. NEVER commit real secrets.

# PostgreSQL connection string (application runtime role in production;
# a separate migration identity is used for prisma migrate — see
# architecture/DATABASE_STRATEGY.md)
DATABASE_URL="postgresql://user:password@localhost:5432/campusconnect?schema=public"

# Planned (Phase 1+): session signing secret — generate with: openssl rand -base64 32
# AUTH_SECRET=""

NEXT_PUBLIC_APP_NAME="CampusConnect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
