# CampusConnect environment template — copy to .env.local and fill in.
# NEVER commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://campusconnect:campusconnect@localhost:5432/campusconnect?schema=public"

# Auth.js / NextAuth v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="CampusConnect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: cookie domain for multi-subdomain tenancy later
# AUTH_COOKIE_DOMAIN=".localhost"
